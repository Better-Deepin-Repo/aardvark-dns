diff --git a/Cargo.toml b/Cargo.toml
index f459957..b972b73 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -22,18 +22,18 @@ platforms = ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu", "powerpc64
